<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Turago Operations</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-900 text-slate-100 flex items-center justify-center min-h-screen p-4">
  <div class="max-w-md w-full bg-slate-800 rounded-2xl border border-slate-700 shadow-2xl p-8">
    <div class="text-center mb-8">
      <div class="w-16 h-16 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl shadow-inner">
        🚗
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-white">Turago Admin Console</h1>
      <p class="text-sm text-slate-400 mt-1">Operations & Captain Verification Portal</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-sm flex items-center gap-3">
        <i class="fa-solid fa-circle-exclamation text-base"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-base"></i>
        <span><%= message %></span>
      </div>
    <% } %>

    <!-- Quick 1-Click Demo Login for fast client presentation -->
    <div class="mb-6 p-4 rounded-xl bg-emerald-950/40 border border-emerald-800/40 text-emerald-200 text-xs">
      <div class="flex items-center justify-between mb-2">
        <span class="font-semibold uppercase tracking-wider text-[11px] text-emerald-400">⚡ Client Demo Mode</span>
        <span class="bg-emerald-500 text-black font-bold px-2 py-0.5 rounded text-[10px]">Instant Access</span>
      </div>
      <p class="text-slate-300 mb-3">Pre-authorized as Super Admin (+919999999999). Click below to enter directly:</p>
      <form action="/admin/demo-login" method="POST">
        <button type="submit" class="w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-lg transition duration-200 flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20">
          <i class="fa-solid fa-bolt"></i> Enter Admin Console (1-Click)
        </button>
      </form>
    </div>

    <div class="relative flex items-center justify-center mb-6">
      <div class="border-t border-slate-700 w-full"></div>
      <span class="bg-slate-800 px-3 text-xs text-slate-400 uppercase tracking-widest font-medium">Or Login with Phone</span>
      <div class="border-t border-slate-700 w-full"></div>
    </div>

    <form action="/admin/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Admin Phone Number</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 text-sm">
            <i class="fa-solid fa-phone"></i>
          </span>
          <input type="text" name="phone" value="+919999999999" required class="w-full bg-slate-900 border border-slate-700 rounded-xl py-3 pl-10 pr-4 text-sm text-white focus:outline-none focus:border-emerald-500 transition">
        </div>
      </div>

      <button type="submit" class="w-full py-3 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded-xl transition flex items-center justify-center gap-2">
        <span>Request OTP</span>
        <i class="fa-solid fa-arrow-right text-xs"></i>
      </button>
    </form>
  </div>
</body>
</html>
