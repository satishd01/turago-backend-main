<!-- Sidebar -->
<aside class="w-64 bg-slate-800 border-r border-slate-700 flex flex-col justify-between shrink-0">
  <div>
    <!-- Logo / Title -->
    <div class="h-16 flex items-center px-6 border-b border-slate-700 gap-3">
      <span class="text-2xl">🚗</span>
      <div>
        <h1 class="font-bold text-lg text-white tracking-wide">TURAGO</h1>
        <p class="text-xs text-brand-500 font-medium tracking-wider uppercase">Admin Console</p>
      </div>
    </div>

    <!-- Navigation links -->
    <nav class="p-4 space-y-1 text-sm font-medium">
      <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= currentPath === '/dashboard' ? 'bg-brand-600 text-white font-semibold' : 'text-slate-300 hover:bg-slate-700 hover:text-white' %>">
        <i class="fa-solid fa-chart-pie w-5 text-center"></i>
        <span>Dashboard</span>
      </a>

      <a href="/admin/drivers" class="flex items-center justify-between px-4 py-3 rounded-lg transition <%= currentPath.startsWith('/drivers') ? 'bg-brand-600 text-white font-semibold' : 'text-slate-300 hover:bg-slate-700 hover:text-white' %>">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-id-card w-5 text-center"></i>
          <span>Driver Approvals</span>
        </div>
        <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
          <span class="bg-amber-500 text-black text-xs font-bold px-2 py-0.5 rounded-full"><%= pendingCount %></span>
        <% } %>
      </a>

      <a href="/admin/rides" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= currentPath.startsWith('/rides') ? 'bg-brand-600 text-white font-semibold' : 'text-slate-300 hover:bg-slate-700 hover:text-white' %>">
        <i class="fa-solid fa-car-side w-5 text-center"></i>
        <span>Bookings & Trips</span>
      </a>

      <a href="/admin/fares" class="flex items-center gap-3 px-4 py-3 rounded-lg transition <%= currentPath.startsWith('/fares') ? 'bg-brand-600 text-white font-semibold' : 'text-slate-300 hover:bg-slate-700 hover:text-white' %>">
        <i class="fa-solid fa-tags w-5 text-center"></i>
        <span>Fare Pricing</span>
      </a>
    </nav>
  </div>

  <!-- Admin User Info / Logout -->
  <div class="p-4 border-t border-slate-700">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3 overflow-hidden">
        <div class="w-9 h-9 rounded-full bg-brand-700 text-white flex items-center justify-center font-bold text-sm shrink-0">
          A
        </div>
        <div class="truncate">
          <p class="text-xs font-medium text-white truncate"><%= typeof admin !== 'undefined' && admin ? admin.name : 'Super Admin' %></p>
          <p class="text-[10px] text-slate-400 truncate">SUPER_ADMIN</p>
        </div>
      </div>
      <a href="/admin/logout" class="text-slate-400 hover:text-rose-400 p-2 transition" title="Logout">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
      </a>
    </div>
  </div>
</aside>
