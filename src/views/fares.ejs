<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 overflow-y-auto p-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-2xl font-bold text-white tracking-tight">Fare Pricing Configuration</h2>
      <p class="text-sm text-slate-400 mt-1">Configure base fare, per km rate, and platform fees for each vehicle category.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% if (fares && fares.length > 0) { %>
      <% fares.forEach(function(fare) { %>
        <div class="bg-slate-800 rounded-2xl border border-slate-700 p-6 flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">CATEGORY</span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 text-brand-400 border border-brand-500/20">
                <%= fare.vehicleType %>
              </span>
            </div>

            <div class="space-y-3 text-sm">
              <div class="flex justify-between py-2 border-b border-slate-700/60">
                <span class="text-slate-400">Base Fare</span>
                <span class="font-bold text-white">₹<%= fare.baseFare %></span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-700/60">
                <span class="text-slate-400">Rate per KM</span>
                <span class="font-bold text-white">₹<%= fare.perKmRate %>/km</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-700/60">
                <span class="text-slate-400">Rate per Minute</span>
                <span class="font-bold text-white">₹<%= fare.perMinuteRate %>/min</span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-700/60">
                <span class="text-slate-400">Minimum Chargeable</span>
                <span class="font-bold text-white">₹<%= fare.minimumFare %></span>
              </div>
              <div class="flex justify-between py-2 border-b border-slate-700/60">
                <span class="text-slate-400">Platform Fee</span>
                <span class="font-bold text-emerald-400">₹<%= fare.platformFee %></span>
              </div>
              <div class="flex justify-between py-2">
                <span class="text-slate-400">GST / Tax Rate</span>
                <span class="font-bold text-white"><%= (fare.taxRate * 100) %>%</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-700">
            <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Active Pricing Formula
            </span>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>
