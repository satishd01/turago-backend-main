{
  "transform": {},
  "testEnvironment": "node",
  "testMatch": ["**/tests/**/*.test.js", "**/__tests__/**/*.test.js"],
  "collectCoverageFrom": [
    "src/**/*.js",
    "!src/docs/**",
    "!src/server.js"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov"],
  "verbose": true
}
