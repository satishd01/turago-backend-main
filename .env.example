# ============================================================
# TURAGO BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=turago-backend

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/turago

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_this_jwt_secret_before_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_before_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP ───────────────────────────────────────────────────────
# OTP expiry in seconds (default: 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300
# Maximum OTP verification attempts
OTP_MAX_ATTEMPTS=5
# Maximum OTP send requests per window
OTP_RATE_LIMIT_MAX=3
# Rate limit window in minutes
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# ── SMS Provider ──────────────────────────────────────────────
# Options: mock (development), twilio, msg91, textlocal
SMS_PROVIDER=mock

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Payment Provider ──────────────────────────────────────────
# Options: mock, razorpay, stripe
PAYMENT_PROVIDER=mock

# Razorpay (if PAYMENT_PROVIDER=razorpay)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Maps / Routing Provider ───────────────────────────────────
# Options: mock, osrm, google
MAP_PROVIDER=mock

# Google Maps (if MAP_PROVIDER=google)
# GOOGLE_MAPS_API_KEY=

# OSRM (if MAP_PROVIDER=osrm)
# OSRM_BASE_URL=http://router.project-osrm.org

# ── Storage Provider ──────────────────────────────────────────
# Options: local, s3, cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 (if STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ── Push Notifications ────────────────────────────────────────
# Options: mock, fcm
PUSH_NOTIFICATION_PROVIDER=mock

# FCM (if PUSH_NOTIFICATION_PROVIDER=fcm)
# FCM_PROJECT_ID=
# FCM_PRIVATE_KEY=
# FCM_CLIENT_EMAIL=

# ── Driver Matching ───────────────────────────────────────────
# Search radius in meters
DRIVER_SEARCH_RADIUS_METERS=5000
# Maximum candidates to evaluate
DRIVER_MAX_CANDIDATES=10
# Seconds driver has to accept a ride
DRIVER_ACCEPT_TIMEOUT_SECONDS=30

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Logging ───────────────────────────────────────────────────
# Levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug
